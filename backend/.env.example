# Copiar a .env y editar segun entorno
# Este .env es leido por docker-compose.yml y por backend/run.ps1

# --- Desarrollo local (Docker) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cosmiclatte
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# --- Produccion / Demo con Supabase (descomenta y completa para probar contra nube) ---
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=5432
# # Si usas Transaction Pooler (PgBouncer) usa 6543 y el host pooler.supabase.com
# # DB_HOST=aws-0-us-east-1.pooler.supabase.com
# # DB_PORT=6543
# DB_NAME=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=tu_password_supabase
# DB_SSLMODE=require
# # Alternativa: URL completa (tiene prioridad sobre DB_HOST/PORT/NAME si se define)
# # JDBC_URL=jdbc:postgresql://db.xxxxx.supabase.co:5432/postgres?sslmode=require

# CORS para el frontend (coma separada si hay varios)
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000

# URL publica del backend (usada para construir audioUrl absoluto servido al frontend)
APP_PUBLIC_URL=http://localhost:8080
# Directorio de audios subidos y tamaño maximo por archivo (bytes)
APP_UPLOAD_DIR=uploads
APP_UPLOAD_MAX_BYTES=20971520
# Clave admin (header X-Admin-Key) para subir/reemplazar/borrar canciones y borrar comentarios
ADMIN_API_KEY=changeme

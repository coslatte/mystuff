# Public URL of the Spring Boot backend (PUBLIC_ prefix = exposed to the browser).
# Local: http://localhost:8080 | Production (Vercel): URL of your deployed backend.
PUBLIC_API_URL=http://localhost:8080

# GitHub access token to fetch pinned repos via GraphQL.
# Important: Do NOT use PUBLIC_ prefix (otherwise the token is exposed on the client).
# Create at: GitHub > Settings > Developer settings > Personal access tokens (classic)
# Required scopes for public read: public_repo (or read:user).
GITHUB_TOKEN=

---
import { messages } from "../lib/i18n/catalog";
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/contact/ContactForm.tsx";
import LocalizedText from "../components/shared/LocalizedText.astro";
---

<Layout
  title="contact ][ cosmiclatte.dev"
  description="Send me a message about a project, music, or a proposal."
>
  <section class="border-b-2 border-brut-black bg-brut-surface p-4 tablet:p-8 laptop:p-10">
    <a href="/" class="editorial-link font-mono text-sm"><LocalizedText id={messages.contact.backToProfile} /></a>
    <p class="brut-label mt-8"><LocalizedText id={messages.contact.section00Contact} /></p>
    <h1 class="mt-4 page-title"><LocalizedText id={messages.contact.sendAMessage} /></h1>
    <p class="mt-5 max-w-2xl leading-7"><LocalizedText id={messages.contact.introDescription} /></p>
  </section>
  <section class="bg-brut-subtle p-4 tablet:p-8 laptop:p-10">
    <ContactForm client:load />
    <noscript>
      <p class="mt-4 border-2 border-brut-black bg-brut-bg p-4 font-mono text-sm">
        Enable JavaScript to send this form. You can also copy gabrielpazruiz02@gmail.com into your email service.
      </p>
    </noscript>
  </section>
</Layout>

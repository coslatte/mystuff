---
import { messages } from "../../lib/i18n/catalog";
import Layout from "../../layouts/Layout.astro";
import ExperimentHeader from "../../components/experiments/ExperimentHeader.astro";
import ExperimentCredits from "../../components/experiments/ExperimentCredits.astro";
import PigmentFlow from "../../components/experiments/PigmentFlow";
import LocalizedText from "../../components/shared/LocalizedText.astro";
---

<Layout
  title="spectral | cosmiclatte"
  description="A stable-fluids simulation that mixes pigments with Kubelka-Munk colour theory."
>
  <ExperimentHeader title="Spectral">
    <p><LocalizedText id={messages.experiments.spectralInstructions} /></p>
  </ExperimentHeader>

  <section class="border-b-2 border-brut-black">
    <div class="p-4 tablet:p-6">
      <PigmentFlow client:load />
    </div>
  </section>
  <ExperimentCredits sources={["spectral"]} />
</Layout>

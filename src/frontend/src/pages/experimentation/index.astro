---
import { messages } from "../../lib/i18n/catalog";
import LocalizedText from "../../components/LocalizedText.astro";
import Layout from "../../layouts/Layout.astro";

const experiments = [
  {
    slug: "spectral",
    title: "Spectral",
    titleKey: messages.experiments.spectral,
    descriptionKey: messages.experiments.spectralDescription,
  },
  {
    slug: "subdivision",
    title: "Subdivision",
    titleKey: messages.experiments.subdivision,
    descriptionKey: messages.experiments.subdivisionDescription,
  },
];
---

<Layout
  title="experimentation | cosmiclatte"
  description="Interactive studies in simulation, geometry, and color, running in the browser."
>
  <section class="border-b-2 border-brut-black bg-brut-surface p-6 tablet:p-8 laptop:p-10">
    <p class="brut-label"><LocalizedText id={messages.experiments.section04Experiments} /></p>
    <h1 class="mt-4 font-display font-black leading-none tracking-tighter"><LocalizedText id={messages.experiments.experiments2} /></h1>
    <p class="mt-5 max-w-2xl text-base leading-7">
      <LocalizedText id={messages.experiments.introDescription} />
    </p>
  </section>
  <section class="grid laptop:grid-cols-2">
    {experiments.map((experiment, index) => (
      <a href={`/experimentation/${experiment.slug}`}
        class:list={[
          "group flex flex-col gap-6 border-b-2 border-brut-black bg-brut-surface p-6 transition-colors hover:bg-brut-blue hover:text-brut-on-accent focus-visible:bg-brut-blue focus-visible:text-brut-on-accent tablet:p-8 laptop:p-10",
          index === 0 && "laptop:border-r-2",
        ]}>
        <div class="flex items-start justify-between gap-6">
          <span class="brut-label bg-brut-surface px-2 py-1">0{index + 1} / study</span>
          <span aria-hidden="true" class="text-2xl transition-transform group-hover:translate-x-1">↗</span>
        </div>
        <div>
          <h2 class="font-display font-black tracking-tighter"><LocalizedText id={experiment.titleKey} /></h2>
          <p class="mt-3 max-w-md leading-7 text-brut-muted group-hover:text-brut-on-accent group-focus-visible:text-brut-on-accent"><LocalizedText id={experiment.descriptionKey} /></p>
        </div>
      </a>
    ))}
  </section>
</Layout>

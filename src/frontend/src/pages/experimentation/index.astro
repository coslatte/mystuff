---
import Layout from "../../layouts/Layout.astro";

const experiments = [
  {
    slug: "spectral",
    title: "Spectral",
    description: "Fluid simulation with pigment mixing.",
  },
  {
    slug: "subdivision",
    title: "Subdivision",
    description: "Recursive rectangle partitioning with adjustable geometry and color.",
  },
];
---

<Layout title="experimentation | cosmiclatte">
  <section class="border-b-2 border-black bg-white p-6 tablet:p-8 laptop:p-10">
    <p class="brut-label text-brut-blue">04 / experiments</p>
    <h1 class="mt-4 font-display text-5xl font-black leading-none tracking-tighter tablet:text-7xl">Experiments</h1>
    <p class="mt-5 max-w-2xl text-base leading-7">
      Studies, and whatever ideas comes to mind, really. Some of the stuff that will be around here are based on thoughts
      and findings on implement those here in the web, such as three.js stuff or simulations.
    </p>
  </section>
  <section class="grid laptop:grid-cols-2">
    {experiments.map((experiment, index) => (
      <a href={`/experimentation/${experiment.slug}`}
        class:list={[
          "group flex flex-col gap-6 border-b-2 border-black bg-white p-6 transition-colors hover:bg-brut-yellow focus-visible:bg-brut-yellow tablet:p-8 laptop:p-10",
          index === 0 && "laptop:border-r-2",
        ]}>
        <div class="flex items-start justify-between gap-6">
          <span class="brut-label text-neutral-500">0{index + 1} / study</span>
          <span aria-hidden="true" class="text-2xl transition-transform group-hover:translate-x-1">↗</span>
        </div>
        <div>
          <h2 class="font-display text-3xl font-black tracking-tighter tablet:text-4xl">{experiment.title}</h2>
          <p class="mt-3 max-w-md leading-7 text-neutral-600">{experiment.description}</p>
        </div>
      </a>
    ))}
  </section>
</Layout>

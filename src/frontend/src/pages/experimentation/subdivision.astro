---
import { messages } from "../../lib/i18n/catalog";
import Layout from "../../layouts/Layout.astro";
import ExperimentHeader from "../../components/ExperimentHeader.astro";
import RecursiveSubdivision from "../../components/RecursiveSubdivision";
import LocalizedText from "../../components/LocalizedText.astro";
---

<Layout
  title="subdivision | cosmiclatte"
  description="Recursive rectangle partitioning with adjustable geometry and colour, drawn from exact tiling."
>
  <ExperimentHeader title="Subdivision">
    <p><LocalizedText id={messages.experiments.subdivisionInstructions} /></p>
  </ExperimentHeader>

  <section class="border-b-2 border-brut-black">
    <div class="p-4 tablet:p-6">
      <RecursiveSubdivision client:load />
    </div>
  </section>
</Layout>

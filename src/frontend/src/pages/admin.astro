---
import Layout from "../layouts/Layout.astro";
import AdminUpload from "../components/admin/AdminUpload";
---

<Layout title="admin ][ cosmiclatte.dev" noindex>
  <section class="border-b-2 border-brut-black bg-brut-blue text-brut-on-accent p-8">
    <h1 class="font-display text-4xl font-black tracking-tighter sm:text-6xl">admin.</h1>
    <p class="mt-4 max-w-md text-brut-inverse font-mono text-sm">
      upload, replace and delete files. you need an admin key.
    </p>
  </section>

  <section class="p-6">
    <AdminUpload client:load />
  </section>
</Layout>

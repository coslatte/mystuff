---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import RepoRow from "../components/RepoRow.astro";
import { fetchContributionSummary, fetchPinnedRepos, fetchRepoMediaImage } from "../services/github";
import type { RepoView } from "../types/github";

const GITHUB_PROFILE = "https://github.com/coslatte";
const GITHUB_HANDLE = "coslatte";

const skills = [
  {
    name: "Frontend, Backend & Programming Languages",
    items: [
      "React, Next.js, Astro, TailwindCSS, responsive UI, API integration",
      "Spring Boot, Spring Security, Spring Data JPA, JWT, FastAPI, REST APIs, DTO design, service and repository patterns",
      "Java, Python, JS/TS, Kotlin, Dart (Flutter), PHP, Rust, Lua, C#, C",
    ],
  },
  {
    name: "AI Agents & Code Editors",
    items: ["Claude Code, Codex, OpenCode, Gemini, Cursor, IntelliJ IDEA, VSCode, Zed, Neovim"],
  },
  {
    name: "Data, Architecture & Tools",
    items: ["PostgreSQL, SQL, SQLite, Flyway, relational modeling, layered and modular architecture, microservices, multi-tenancy, RBAC, Git, GitHub Actions, Docker, Maven, Gradle"],
  },
];

// The pinned repos are the single source of truth for this section. When the
// GitHub API is unavailable (no token, rate limit, outage) we show an empty
// state instead of a hardcoded list that would drift from the real profile.
const [pinned, contributions] = await Promise.all([
  fetchPinnedRepos(GITHUB_HANDLE),
  fetchContributionSummary(GITHUB_HANDLE),
]);

const repos: RepoView[] = await Promise.all(
  pinned.map(async (repo, index): Promise<RepoView> => ({
    index: String(index + 1).padStart(2, "0"),
    title: repo.name,
    category: repo.primaryLanguage?.name || "Project",
    description: repo.description || "No description on GitHub.",
    tags: repo.repositoryTopics.nodes.map((node) => node.topic.name),
    imageSrc: await fetchRepoMediaImage(repo.url),
    githubUrl: repo.url,
  }))
);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=3600"
);
---

<Layout title="coding ][ cosmiclatte.dev">
  <section class="border-b-2 border-black bg-white">
    <div class="grid gap-8 p-6 tablet:p-8 laptop:grid-cols-[1fr_18rem] laptop:items-end laptop:p-10">
      <div>
        <p class="brut-label">02 / coding</p>
        <h1 class="mt-4 font-display text-5xl font-black leading-none tracking-tighter tablet:text-7xl">Work in code.</h1>
        <p class="mt-5 max-w-2xl text-base leading-7">
          Backend systems, tools, and experimentation software. The projects below come from
          my pinned GitHub repositories and update with my profile.
        </p>
      </div>
      <a class="editorial-link justify-self-start laptop:justify-self-end" href={GITHUB_PROFILE} target="_blank" rel="noopener noreferrer">open GitHub ↗</a>
    </div>
  </section>

  <section id="skills" class="bg-white">
    <div class="border-b-2 border-black p-6 tablet:p-8 laptop:p-10">
      <p class="brut-label">Skills</p>
      <h2 class="mt-3 font-display text-3xl font-black tracking-tighter tablet:text-5xl">What I work with.</h2>
    </div>
    <div class="grid tablet:grid-cols-2">
      {skills.map((skill, index) => (
        <article class:list={[
          "border-b-2 border-black p-6 tablet:p-8 laptop:p-10",
          index === 0 ? "tablet:col-span-2" : index === 1 && "tablet:border-r-2",
        ]}>
          <h3 class="font-display text-2xl font-black tracking-tight">{skill.name}</h3>
          {skill.items.map((item) => (
            <p class="mt-4 max-w-3xl leading-7 text-neutral-700">{item}.</p>
          ))}
        </article>
      ))}
    </div>
  </section>

  <section id="profile" class="grid grid-cols-1 border-b-2 border-black laptop:grid-cols-[17rem_minmax(0,1fr)]">
    <div class="flex items-center gap-4 border-b-2 border-black bg-brut-blue text-white p-6 laptop:flex-col laptop:items-start laptop:justify-center laptop:border-b-0 laptop:border-r-2 laptop:p-8">
      <div class="h-20 w-20 shrink-0 overflow-hidden border-2 border-black bg-neutral-200">
        <img
          src="https://github.com/coslatte.png?size=400"
          alt=""
          class="h-full w-full object-cover contrast-100"
        />
      </div>
      <div class="min-w-0">
        <p class="brut-label inline-block bg-white px-2 py-1">GitHub profile</p>
        <a
          href={GITHUB_PROFILE}
          target="_blank"
          rel="noopener noreferrer"
          class="font-display text-3xl font-black leading-none tracking-tighter underline"
        >
          @{GITHUB_HANDLE}
        </a>
      </div>
    </div>

    <div class="min-w-0 bg-white p-6 tablet:p-8">
      <h2 class="brut-label">Contributions / last 12 months</h2>
      {contributions ? (
        <>
          <p class="mt-3 font-display text-3xl font-black tracking-tighter">
            {contributions.totalContributions.toLocaleString("en-US")} contributions
          </p>
          <div class="mt-5 overflow-x-auto pb-2" tabindex="0" role="region" aria-label="Daily GitHub contributions, scroll horizontally to view the full year">
            <div class="grid min-w-[40rem] grid-cols-[2rem_minmax(0,1fr)] gap-x-2 gap-y-2">
              <div></div>
              <div class="grid gap-[3px] font-mono text-[10px] text-neutral-600" style={`grid-template-columns: repeat(${contributions.weeks.length}, minmax(0, 1fr))`} aria-hidden="true">
                {contributions.weeks.map((week, index) => {
                  const day = index === 0 ? week.contributionDays[0] : week.contributionDays.find((day) => day.date.endsWith("-01"));
                  return <span class="overflow-visible whitespace-nowrap">{day ? new Date(`${day.date}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", timeZone: "UTC" }) : ""}</span>;
                })}
              </div>
              <div class="grid grid-rows-7 items-center font-mono text-[10px] text-neutral-600" aria-hidden="true">
                <span class="row-start-2">Mon</span><span class="row-start-4">Wed</span><span class="row-start-6">Fri</span>
              </div>
              <div class="grid gap-[3px]" style={`grid-template-columns: repeat(${contributions.weeks.length}, minmax(0, 1fr))`} role="img" aria-label={`${contributions.totalContributions.toLocaleString("en-US")} GitHub contributions over the last 12 months. Darker squares indicate more contributions.`}>
                {contributions.weeks.map((week) => (
                  <div class="grid grid-rows-7 gap-[3px]">
                    {week.contributionDays.map((day) => (
                      <span class="aspect-square border border-black/10" style={`grid-row: ${day.weekday + 1}; background-color: ${day.color}`} title={`${day.date}: ${day.contributionCount} contributions`} aria-hidden="true"></span>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>
          <p class="mt-2 font-mono text-[10px] text-neutral-600">Each square is one day. Darker squares indicate more contributions.</p>
        </>
      ) : (
        <p class="mt-4 font-mono text-sm text-neutral-600">
          Contribution data is unavailable. <a class="underline" href={`${GITHUB_PROFILE}?tab=overview`} target="_blank" rel="noopener noreferrer">View activity on GitHub ↗</a>
        </p>
      )}
    </div>
  </section>

  <section id="repos" class="bg-white">
    <div class="flex items-center justify-between gap-4 border-b-2 border-black bg-neutral-100 px-6 py-4 tablet:px-8">
      <h2 class="font-display text-xl font-bold">Pinned repositories</h2>
      <span class="brut-label">{repos.length} projects</span>
    </div>

    {repos.length > 0
      ? repos.map((repo) => <RepoRow {...repo} />)
      : (
        <p class="border-b-2 border-black bg-white p-8 text-center font-mono text-sm">
          Repositories are unavailable right now.{" "}
          <a
            href="https://github.com/coslatte?tab=repositories"
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-link">See them on GitHub ↗</a>
        </p>
      )}
  </section>
</Layout>

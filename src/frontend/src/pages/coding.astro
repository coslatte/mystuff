---
import Layout from "../layouts/Layout.astro";
import CodingIntro from "../components/coding/CodingIntro.astro";
import CodingExperience from "../components/coding/CodingExperience.astro";
import CodingSkills from "../components/coding/CodingSkills.astro";
import GithubProfile from "../components/coding/GithubProfile.astro";
import PinnedRepositories from "../components/coding/PinnedRepositories.astro";
import { fetchContributionSummary, fetchPinnedRepos, fetchRepoMediaImage } from "../services/github";
import type { RepoView } from "../types/github";

export const prerender = false;

const GITHUB_PROFILE = "https://github.com/coslatte";
const GITHUB_HANDLE = "coslatte";

// An unavailable GitHub API shows the empty state instead of a stale fallback list.
const [pinned, contributions] = await Promise.all([
  fetchPinnedRepos(GITHUB_HANDLE),
  fetchContributionSummary(GITHUB_HANDLE),
]);

const repos: RepoView[] = await Promise.all(
  pinned.map(async (repo, index): Promise<RepoView> => ({
    index: String(index + 1).padStart(2, "0"),
    title: repo.name,
    category: repo.primaryLanguage?.name || "Project",
    description: repo.description || "No description on GitHub.",
    tags: repo.repositoryTopics.nodes.map((node) => node.topic.name),
    imageSrc: await fetchRepoMediaImage(repo.url),
    githubUrl: repo.url,
  }))
);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=3600"
);
---

<Layout
  title="coding ][ cosmiclatte.dev"
  description="Backend systems, tooling, and experimental software, with pinned GitHub repositories and a live contribution calendar."
>
  <CodingIntro profileUrl={GITHUB_PROFILE} />

  <CodingExperience />

  <CodingSkills />

  <GithubProfile profileUrl={GITHUB_PROFILE} handle={GITHUB_HANDLE} contributions={contributions} />

  <PinnedRepositories repos={repos} />
</Layout>

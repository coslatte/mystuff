---
import Layout from "../layouts/Layout.astro";
import MusicSection from "../components/MusicSection";
import SocialButton from "../components/SocialButton.astro";

const socials = [
  { name: "soundcloud", url: "https://soundcloud.com/cosmiclattemusic" },
  { name: "spotify", url: "https://open.spotify.com/intl-es/artist/35cspPwQYNmbLf76EbI0oP" },
  { name: "bandcamp", url: "https://cosmiclatteedm.bandcamp.com/" },
  { name: "youtube", url: "https://www.youtube.com/@cosmiclattemusic" },
  { name: "x", url: "https://x.com/CosmicLatteEdm" },
  { name: "linktree", url: "https://linktr.ee/CosmicLatteEdm" },
  { name: "telegram", url: "https://t.me/cosmiclatteofficialchannel" },
] as const;
---

<Layout title="music ][ cosmiclatte.dev">
  <section class="border-b-2 border-black bg-white">
    <div class="grid gap-2 p-6 tablet:p-8 laptop:grid-cols-[1fr_18rem] laptop:items-end laptop:p-10">
      <div>
        <p class="brut-label">01 / music</p>
        <h1 class="mt-4 font-display text-5xl font-black leading-none tracking-tighter tablet:text-7xl">sounds i've crafted</h1>
        <p class="mt-5 max-w-2xl text-base leading-7">
          Here are my original tracks and releases. Listen, rate or maybe and leave some comments for those work in progress stuff.
          I've also have some influences and some story telling about my experiencie.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b-2 border-black bg-neutral-100 p-6 tablet:p-8 laptop:p-10" aria-label="Music platforms">
    <p class="brut-label mb-4">Platforms and links</p>
    <div class="flex flex-wrap gap-2">
      {socials.map((social) => <SocialButton name={social.name} url={social.url} />)}
    </div>
  </section>

  <MusicSection client:load />

</Layout>

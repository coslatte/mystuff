---
interface Props {
  index: string;
  title: string;
  category: string;
  description: string;
  tags: string[];
  imageSrc?: string | null;
  githubUrl?: string;
}

const { index, title, category, description, tags, imageSrc, githubUrl } = Astro.props;
---

<article class="grid gap-5 border-b-2 border-black p-6 tablet:grid-cols-[3rem_minmax(0,1fr)_minmax(10rem,14rem)] tablet:gap-7 tablet:p-8 laptop:p-10">
  <span class="font-mono text-xs font-bold text-neutral-500">{index}</span>
  <div class="min-w-0">
    <p class="brut-label">{category}</p>
    <h3 class="mt-2 break-words font-display text-2xl font-black tracking-tight tablet:text-3xl">{title}</h3>
    <p class="mt-3 max-w-xl leading-7 text-neutral-700">{description}</p>
    {tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => <li class="brut-chip">#{tag}</li>)}
      </ul>
    )}
    {githubUrl && (
      <a class="editorial-link mt-6" href={githubUrl} target="_blank" rel="noopener noreferrer">view code ↗</a>
    )}
  </div>
  {imageSrc && (
    <img src={imageSrc} alt="" loading="lazy" class="aspect-[4/3] w-full border-2 border-black bg-neutral-100 object-cover" />
  )}
</article>

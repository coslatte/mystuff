---
import LanguageSelector from "./LanguageSelector.astro";
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const links = [
  { href: "/", label: "home", number: "01" },
  { href: "/coding", label: "coding", number: "02" },
  { href: "/music", label: "music", number: "03" },
  { href: "/experimentation", label: "experiments", number: "04" },
  { href: "/forum", label: "forum", number: "05" },
].map((link) => ({
  ...link,
  active: link.href === "/" ? pathname === "/" : pathname.startsWith(link.href),
}));
---

<header class="border-b-2 border-t-2 border-brut-black bg-brut-surface">
  <div class="grid w-full laptop:grid-cols-[auto_1fr]">
    <div class="flex min-w-0 items-center justify-between border-x-2 border-b-2 border-brut-black bg-brut-inverse text-brut-on-accent laptop:border-b-0 laptop:border-r-2">
    <a href="/" data-cursor-skip class="flex min-h-16 min-w-0 items-center px-3 font-display text-lg font-black tracking-tighter tablet:px-5 tablet:text-xl">
      <span>cosmiclatte<span class="text-brut-green">.</span>dev</span>
    </a>
    <div class="px-2 py-1 tablet:px-3">
      <LanguageSelector />
    </div>
    </div>
    <div class="flex min-w-0">
    <nav aria-label="Main navigation" class="grid min-w-0 flex-1 grid-cols-2 border-l-2 border-t-2 border-brut-black tablet:grid-cols-5 tablet:border-l-0 tablet:border-t-0">
      {links.map((link) => (
        <a href={link.href} aria-current={link.active ? "page" : undefined}
          class:list={[
            "group flex min-h-12 items-center justify-between gap-2 " +
            "border-r-2 border-b-2 border-brut-black px-4 py-2 font-mono text-xs font-bold" +
            "transition-colors focus-visible:outline-2 focus-visible:-outline-offset-4 " +
            "focus-visible:outline-brut-blue tablet:min-h-16 tablet:border-b-0 tablet:px-5 tablet:text-sm",
            link.active ? "bg-brut-blue text-brut-on-accent" : "hover:bg-brut-subtle",
          ]}>
          <span>{link.label}</span>
          <span class:list={["text-[10px]", link.active ? "text-brut-on-accent" : "text-brut-muted"]}>{link.number}</span>
        </a>
      ))}
    </nav>
    <button type="button" data-theme-toggle aria-label="Dark mode" aria-pressed="false" title="Dark mode"
      class="hidden w-12 shrink-0 items-center justify-center border-r-2 border-brut-black bg-brut-surface text-brut-black hover:bg-brut-subtle focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-brut-blue tablet:w-16">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20.9 13a9 9 0 0 1-9.9-9.9A9 9 0 1 0 20.9 13Z" />
      </svg>
    </button>
    </div>
  </div>
</header>

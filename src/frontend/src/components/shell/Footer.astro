---
import { messages } from "../../lib/i18n/catalog";
import LocalizedText from "../shared/LocalizedText.astro";
import NowPlaying from "./NowPlaying.astro";
import "../../styles/shell/footer.css";

interface Props {
  showContact?: boolean;
}

const { showContact = true } = Astro.props;
---

<footer id="page-bottom" tabindex="-1" aria-label="Contact" class="site-footer mx-auto w-full max-w-7xl border-x-2 border-t-2 border-b-2 border-brut-black bg-brut-surface tv:max-w-[100rem]">
  <p class="font-mono text-xs" translate="no">Gabriel Paz / CosmicLatte</p>
  {showContact && <a href="/contact" class="footer-contact brut-up"><span><span><LocalizedText id={messages.common.contact} /></span> <span aria-hidden="true">↗</span></span></a>}
  <nav
    class="page-jumps"
    aria-label="Page shortcuts"
    data-i18n-aria-label={messages.navigation.pageShortcuts}
    data-cursor-target
  >
    <a
      class="brut-up"
      href="#page-top"
      data-page-jump="up"
      aria-label="Back to top"
      data-i18n-aria-label={messages.navigation.pageTop}
      title="Back to top"
      data-i18n-title={messages.navigation.pageTop}>
        <span aria-hidden="true">↑</span>
        <span class="jump-label">
          <LocalizedText id={messages.navigation.pageTop} />
        </span>
    </a>
    <a
      class="brut-up"
      href="#page-bottom"
      data-page-jump="down"
      aria-label="Go to page end"
      data-i18n-aria-label={messages.navigation.pageEnd}
      title="Go to page end"
      data-i18n-title={messages.navigation.pageEnd}>
        <span aria-hidden="true">↓</span>
        <span class="jump-label">
          <LocalizedText id={messages.navigation.pageEnd} />
        </span>
    </a>
  </nav>
</footer>

<script>
  import "../../browser/shell/footer";
</script>

<div class="page-jump-swipe" data-page-jump-swipe aria-hidden="true"></div>

<footer
  data-audio-player
  aria-label="Audio player"
  class="sticky bottom-0 z-40 hidden h-16 shrink-0 animate-footer-rise border-t-2 border-brut-black bg-brut-surface has-[now-playing-el[data-playing]]:flex motion-reduce:animate-none"
  style="transition: transform 180ms ease"
>
  <button
    type="button"
    data-footer-toggle
    class="absolute -top-8 right-4 flex h-8 w-10 items-center justify-center border-2 border-b-0 border-brut-black bg-brut-surface font-mono text-sm font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brut-blue"
    aria-label="hide player"
    aria-expanded="true"
    aria-controls="now-playing-player"
  ><span aria-hidden="true">↓</span></button>
  <div
    id="now-playing-player"
    class="mx-auto flex h-full w-full max-w-7xl items-center justify-center px-4"
    transition:name="now-playing"
    transition:persist="now-playing"
  >
    <NowPlaying />
  </div>
</footer>

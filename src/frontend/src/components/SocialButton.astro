const s = data[name];
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="soc"
  style={`--brand:${s.color}`}
  aria-label={`${s.label} ${s.handle}`}
>
  <span class="soc__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d={s.path} /></svg>
  </span>
  <span class="soc__copy"><span class="soc__name">{s.label}</span><span class="soc__handle">{s.handle}</span></span>
</a>

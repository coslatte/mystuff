---
import { messages } from "../../lib/i18n/catalog";
import LocalizedText from "../shared/LocalizedText.astro";
import "../../styles/home/brut-word.css";
import "../../styles/home/hero.css";
---

<section class="border-b-2 border-brut-black bg-brut-surface">
  <div class="px-6 py-10 text-center tablet:px-8 tablet:py-12 laptop:px-10">
    <p class="brut-label">Gabriel Paz / Cuba</p>
    <h1 class="hero-title mx-auto mt-6 max-w-5xl wrap-break-word font-display text-[clamp(2.75rem,10vw,7.5rem)] font-black leading-[1.05] tracking-[-0.07em]">
      <LocalizedText id={messages.home.i} /> <span class="brut-word brut-word--code">
        <span class="brut-word__code-clip" aria-hidden="true">
          <pre class="brut-word__code-matrix"></pre>
        </span><span class="brut-word__code-label"><LocalizedText id={messages.home.code} /></span>
      </span> <LocalizedText id={messages.home.shrink} />
      <span
        class="brut-word brut-word--soundwaves"
        data-fm-wave
        style="--soundwave-mask: url('#soundwaves-fm-mask')"
      >
        <span><LocalizedText id={messages.home.soundwaves} /></span>
        <span class="brut-word__wave-text" aria-hidden="true"><LocalizedText id={messages.home.soundwaves} /></span>
        <svg class="brut-word__mask-defs" viewBox="0 0 1 1" aria-hidden="true" focusable="false">
          <defs>
            <mask id="soundwaves-fm-mask" maskUnits="objectBoundingBox" maskContentUnits="objectBoundingBox" mask-type="alpha" x="0" y="0" width="1" height="1">
              <path
                data-fm-path
                fill="white"
                d="M0 0.5 C0.055 0.1 0.111 0.1 0.167 0.5 C0.222 0.9 0.278 0.9 0.333 0.5 C0.389 0.1 0.444 0.1 0.5 0.5 C0.556 0.9 0.611 0.9 0.667 0.5 C0.722 0.1 0.778 0.1 0.833 0.5 C0.889 0.9 0.944 0.9 1 0.5 L1 1 L0 1 Z"
              />
            </mask>
          </defs>
        </svg>
      </span>
    </h1>
  </div>
</section>

<script>
  import { buildFmWavePath, fmWaveOffset } from "../../lib/graphics/fm-wave";

  const codeFragments = [
    `function mix(start: number, end: number, progress: number): number {
  return start + (end - start) * progress;
}`,
    `export function clampCamera(camera: Camera): Camera {
  const zoom = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, camera.zoom));
  const halfX = 0.5 / zoom;
  const halfY = 0.5 / zoom;
  return {
    zoom,
    cx: clamp(camera.cx, halfX, 1 - halfX),
    cy: clamp(camera.cy, halfY, 1 - halfY),
  };
}`,
    `default SongResponse toResponse(Song song, String audioUrl, Double avgRating, Long totalVotes, Integer myRating) {
    SongResponse response = toResponse(song);
    return new SongResponse(
        response.id(),
        response.title(),
        response.artist(),
        response.duration(),
        audioUrl,
        response.createdAt(),
        avgRating,
        totalVotes,
        myRating);
}`,
    `private SongResponse toResponse(Song song, SongRatingSummary summary, Integer myRating) {
    long total = summary == null ? 0L : summary.getTotal();
    Double avg = total == 0 ? null : summary.getAverage();
    String audioUrl = song.getAudioUrl() == null ? null : fileStorage.signedUrl(song.getAudioUrl());
    return songMapper.toResponse(song, audioUrl, avg, total, myRating);
}`,
  ] satisfies [string, ...string[]];
  const codeMatrix = document.querySelector<HTMLPreElement>(".brut-word__code-matrix");
  if (codeMatrix) {
    const fragment = codeFragments[Math.floor(Math.random() * codeFragments.length)] ?? codeFragments[0];
    // Whole blocks only: an even count makes the half-height CSS loop seamless, and enough
    // of them keep the tilted box covering the word at the top of the loop.
    const blocks = 2 * Math.ceil(20 / fragment.split("\n").length);
    codeMatrix.textContent = Array.from({ length: blocks }, () => fragment).join("\n");
  }

  const FRAME_INTERVAL_MS = 1000 / 30;
  const canHover = window.matchMedia("(hover: hover)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let frameId: number | null = null;
  let activePath: SVGPathElement | null = null;
  let startedAt = 0;
  let lastFrameAt = 0;

  function stopWave(): void {
    if (frameId !== null) cancelAnimationFrame(frameId);
    frameId = null;
    activePath = null;
  }

  function drawWave(now: number): void {
    if (!activePath) {
      frameId = null;
      return;
    }

    if (now - lastFrameAt >= FRAME_INTERVAL_MS) {
      const elapsed = now - startedAt;
      activePath.setAttribute("d", buildFmWavePath(elapsed, fmWaveOffset(elapsed)));
      lastFrameAt = now;
    }

    frameId = requestAnimationFrame(drawWave);
  }

  function bindWave(): void {
    const word = document.querySelector<HTMLElement>("[data-fm-wave]");
    const path = word?.querySelector<SVGPathElement>("[data-fm-path]");
    if (!word || !path || word.dataset.fmBound) return;

    word.dataset.fmBound = "true";
    word.addEventListener("transitionend", (event) => {
      if (
        event.target !== word ||
        event.propertyName !== "transform" ||
        !word.matches(":hover") ||
        !canHover.matches ||
        reducedMotion.matches ||
        frameId !== null
      ) return;

      activePath = path;
      startedAt = performance.now();
      activePath.setAttribute("d", buildFmWavePath(0, 0));
      lastFrameAt = startedAt - FRAME_INTERVAL_MS;
      frameId = requestAnimationFrame(drawWave);
    });

    word.addEventListener("pointerleave", stopWave);
  }

  bindWave();
  document.addEventListener("astro:page-load", bindWave);
  document.addEventListener("astro:before-swap", stopWave);
  reducedMotion.addEventListener("change", (event) => {
    if (event.matches) stopWave();
  });
</script>

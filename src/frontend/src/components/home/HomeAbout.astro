---
import { messages } from "../../lib/i18n/catalog";
import LocalizedText from "../shared/LocalizedText.astro";
import FluidPanel from "./FluidPanel.astro";

const background = [
  { label: messages.home.education, text: messages.home.educationDescription },
  { label: messages.home.research, text: messages.home.researchDescription },
  { label: messages.home.languages, text: messages.home.spokenLanguages },
] as const;
---

<section id="about" class="overflow-x-clip border-b-2 border-brut-black bg-brut-surface">
  <div class="grid laptop:grid-cols-[minmax(15rem,0.8fr)_minmax(0,1.6fr)]">
    <div class="relative isolate overflow-hidden border-b-2 border-brut-black bg-brut-bg p-6 tablet:p-8 laptop:flex laptop:flex-col laptop:items-center laptop:justify-center laptop:gap-8 laptop:border-b-0 laptop:border-r-2 laptop:p-10">
      <FluidPanel />
      <div class="relative">
        <p class="brut-label relative text-center"><LocalizedText id={messages.home.aboutSection} /></p>
        <h2 class="relative mx-auto mt-6 max-w-lg text-center font-display font-black leading-[1.05] tracking-tighter">
          <LocalizedText id={messages.home.aboutTitle} />
        </h2>
      </div>
      <img src="https://github.com/coslatte.png?size=800" alt="pfp"
        class="profile-photo relative mx-auto aspect-square border-2 border-brut-black bg-brut-soft object-cover shadow-[6px_6px_0_var(--color-brut-black)]" />
    </div>
    <div class="grid gap-8 p-6 tablet:p-8 laptop:p-10">
      <p class="max-w-3xl text-lg leading-relaxed tablet:text-xl">
        <LocalizedText id={messages.home.aboutDescription} />
      </p>
      {background.map((item) => (
        <div class="grid gap-3 border-t-2 border-brut-black pt-6 tablet:grid-cols-[8rem_1fr] tablet:gap-6">
          <p class="brut-label"><LocalizedText id={item.label} /></p>
          <p class="max-w-2xl leading-7"><LocalizedText id={item.text} /></p>
        </div>
      ))}
    </div>
  </div>
</section>

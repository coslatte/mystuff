---
/*
 * The ink behind the "a little about myself" panel on `/`.
 *
 * The solver is `lib/sim`, the picture is `lib/sim/fluid-panel`, and nothing here
 * knows either exists. The canvas is larger than the panel on purpose: it paints ink
 * with an alpha channel rather than an opaque paper rectangle, so the part that
 * crosses the border fades into the section instead of laying a cream box over it.
 * That is why the host must be `relative` and must not clip.
 */
---

<div class="pointer-events-none absolute -inset-5 -bottom-9 -z-10" aria-hidden="true">
  <canvas data-fluid-panel class="pointer-events-auto block h-full w-full touch-none opacity-85 saturate-75 contrast-90"></canvas>
</div>

<script>
  import { mountFluidPanel } from "../lib/sim/fluid-panel";

  // Released on the way out, because a loop left running paints into a canvas the
  // router has already detached.
  const canvas = document.querySelector<HTMLCanvasElement>("[data-fluid-panel]");
  if (canvas && canvas.dataset.bound !== "true") {
    canvas.dataset.bound = "true";
    const release = mountFluidPanel(canvas);
    document.addEventListener("astro:before-swap", release, { once: true });
  }
</script>

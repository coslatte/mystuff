---
import "../styles/brut-word.css";
---

<section class="grid border-b-2 border-black bg-white laptop:grid-cols-[minmax(0,1.5fr)_minmax(17rem,0.7fr)]">
  <div class="flex flex-col justify-between gap-12 p-6 tablet:p-8 laptop:min-h-128 laptop:border-r-2 laptop:border-black laptop:p-10">
    <div>
      <p class="brut-label">Gabriel Paz / Cuba</p>
      <h1 class="mt-8 w-full text-center font-display text-[clamp(3.4rem,10vw,7.5rem)] font-black leading-[1.05] tracking-[-0.07em]">
        <span class="brut-word">code</span> & <span class="brut-word">sounds</span>
      </h1>
    </div>
    <div class="flex flex-col gap-5 tablet:flex-row tablet:items-end tablet:justify-between">
      <p class="max-w-lg text-base leading-7 tablet:text-lg">
        I'm a software engineer and music producer. I build fullstack applications and manipulate sounds.
      </p>
      <a class="editorial-link shrink-0 self-start tablet:self-auto" href="#about">get to know me ↓</a>
    </div>
  </div>
  <div class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-4 border-t-2 border-black bg-brut-black p-6 tablet:p-8 laptop:grid-cols-1 laptop:border-t-0 laptop:p-10">
    <img src="https://github.com/coslatte.png?size=800" alt="Portrait of Gabriel Paz"
      class="aspect-square w-full max-w-80 border-2 border-black bg-neutral-200 object-cover" />
    <p class="brut-label text-white [writing-mode:vertical-rl] laptop:[writing-mode:horizontal-tb]">
      Software / music / experiments
    </p>
  </div>
</section>

---
import "../styles/brut-word.css";
---

<section class="border-b-2 border-black bg-white">
  <div class="border-b-2 border-black px-6 py-10 text-center tablet:px-8 tablet:py-12 laptop:px-10">
    <p class="brut-label">Gabriel Paz / Cuba</p>
    <h1 class="mx-auto mt-6 max-w-5xl font-display text-[clamp(3.4rem,10vw,7.5rem)] font-black leading-[1.05] tracking-[-0.07em]">
      <span class="brut-word">code</span> & <span class="brut-word">sounds</span>
    </h1>
  </div>
  <div class="grid laptop:grid-cols-[minmax(0,1.5fr)_minmax(17rem,0.7fr)]">
    <div class="flex flex-col justify-center gap-6 p-6 tablet:p-8 laptop:border-r-2 laptop:border-black laptop:p-10">
      <p class="max-w-xl text-base leading-7 tablet:text-lg">
        I'm a software engineer and music producer. I build fullstack applications and manipulate sounds.
      </p>
      <a class="editorial-link self-start" href="#about">get to know me ↓</a>
    </div>
    <div class="flex items-center gap-6 border-t-2 border-black bg-brut-black p-6 tablet:p-8 laptop:border-t-0">
      <img src="https://github.com/coslatte.png?size=800" alt="Portrait of Gabriel Paz" width="800" height="800"
        class="aspect-square w-28 shrink-0 border-2 border-black bg-neutral-200 object-cover tablet:w-36" />
      <p class="brut-label text-white">software / music / experimentation</p>
    </div>
  </div>
</section>

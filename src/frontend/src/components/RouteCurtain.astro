---
import "../styles/route-curtain.css";
import { curtainCells } from "../lib/route-curtain";

/*
 * The route curtain.
 *
 * Server-rendered into every response and hidden until the controller marks it,
 * for the same reason the splash is: the script that reveals it is the script
 * that takes it away, so a bundle that fails to load leaves no overlay over the
 * site.
 *
 * Persisted across swaps rather than re-rendered. The interesting half of this
 * component plays *after* the new page has landed, and without `transition:persist`
 * the DOM it animates is destroyed by that very swap. MorphlingCursor.astro
 * persists for the mirror-image reason.
 */

const { cells, ink } = curtainCells();
---

<div class="route-curtain" data-route-curtain role="status" aria-live="polite"
  aria-label="loading" transition:persist="route-curtain">
  {
    cells.map((cell, index) => (
      <div
        class={`route-curtain__cell route-curtain__cell--${ink[index] ? "ink" : "paper"}`}
        data-route-curtain-cell
        style={`left:${cell.x0 * 100}%;top:${cell.y0 * 100}%;width:${(cell.x1 - cell.x0) * 100}%;height:${(cell.y1 - cell.y0) * 100}%`}
      />
    ))
  }

  <div class="route-curtain__plate">
    <span class="route-curtain__caption">loading</span>
    <span class="route-curtain__target" data-route-curtain-label>&nbsp;</span>
  </div>
</div>

<script>
  import { startRouteCurtain } from "../lib/route-curtain";

  // Persisted, so the element survives the swap and its `data-state` is still
  // there when the controller comes back around. Two controllers on one overlay
  // would each tear down the other's timers.
  const curtain = document.querySelector<HTMLElement>("[data-route-curtain]");
  if (curtain && curtain.dataset.bound !== "true") {
    curtain.dataset.bound = "true";
    startRouteCurtain();
  }
</script>
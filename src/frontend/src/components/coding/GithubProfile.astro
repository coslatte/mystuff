---
import { messages } from "../../lib/i18n/catalog";
import LocalizedText from "../shared/LocalizedText.astro";
import type { ContributionSummary } from "../../types/github";
import { contributionTip } from "../../lib/coding/contribution-tip";

interface Props {
  profileUrl: string;
  handle: string;
  contributions: ContributionSummary | null;
}

const { profileUrl: GITHUB_PROFILE, handle: GITHUB_HANDLE, contributions } = Astro.props;
---

<section id="profile" class="grid grid-cols-1 border-b-2 border-brut-black laptop:grid-cols-[17rem_minmax(0,1fr)]">
  <div class="flex items-center gap-4 border-b-2 border-brut-black bg-brut-blue text-brut-on-accent p-6 laptop:flex-col laptop:items-start laptop:justify-center laptop:border-b-0 laptop:border-r-2 laptop:p-8">
    <div class="h-20 w-20 shrink-0 overflow-hidden border-2 border-brut-black bg-brut-soft">
      <img
        src="https://github.com/coslatte.png?size=400"
        alt=""
        class="h-full w-full object-cover contrast-100"
      />
    </div>
    <div class="min-w-0">
      <p class="brut-label inline-block bg-brut-surface px-2 py-1"><LocalizedText id={messages.coding.githubProfile} /></p>
      <a
        href={GITHUB_PROFILE}
        target="_blank"
        rel="noopener noreferrer"
        class="font-display text-3xl font-black leading-none tracking-tighter underline"
      >
        @{GITHUB_HANDLE}
      </a>
    </div>
  </div>

  <div class="min-w-0 bg-brut-surface p-6 tablet:p-8">
    <h2 class="brut-label"><LocalizedText id={messages.coding.contributionsLast12Months} /></h2>
    {contributions ? (
      <>
        <p class="mt-3 font-display text-3xl font-black tracking-tighter">
          {contributions.totalContributions.toLocaleString("en-US")} <LocalizedText id={messages.coding.contributions} />
        </p>
        <div class="mt-5 overflow-x-auto pb-2" tabindex="0" role="region" aria-label="Daily GitHub contributions, scroll horizontally to view the full year">
          <div class="grid min-w-160 grid-cols-[2rem_minmax(0,1fr)] gap-x-2 gap-y-2">
            <div></div>
            <div class="grid gap-0.75 font-mono text-[10px] text-brut-muted" style={`grid-template-columns: repeat(${contributions.weeks.length}, minmax(0, 1fr))`} aria-hidden="true">
              {contributions.weeks.map((week, index) => {
                const day = index === 0 ? week.contributionDays[0] : week.contributionDays.find((day) => day.date.endsWith("-01"));
                return <span class="overflow-visible whitespace-nowrap">{day ? new Date(`${day.date}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", timeZone: "UTC" }) : ""}</span>;
              })}
            </div>
    <div class="grid grid-rows-7 items-center font-mono text-[10px] text-brut-muted" aria-hidden="true">
              <span class="row-start-2"><LocalizedText id={messages.coding.mon} /></span><span class="row-start-4"><LocalizedText id={messages.coding.wed} /></span><span class="row-start-6"><LocalizedText id={messages.coding.fri} /></span>
            </div>
            <div class="grid gap-0.75" data-contribution-grid data-cursor="precision" style={`grid-template-columns: repeat(${contributions.weeks.length}, minmax(0, 1fr))`} role="img" aria-label={`${contributions.totalContributions.toLocaleString("en-US")} GitHub contributions over the last 12 months. Darker squares indicate more contributions.`}>
              {contributions.weeks.map((week) => (
                <div class="grid grid-rows-7 gap-0.75">
                  {week.contributionDays.map((day) => (
                    <span class="contribution-day aspect-square border border-brut-black/10" style={`grid-row: ${day.weekday + 1}; background-color: ${day.color}`} data-tip={contributionTip(day.contributionCount, day.date)} aria-hidden="true"></span>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
        <div
          data-contribution-tip
          aria-hidden="true"
          class="pointer-events-none fixed z-50 hidden border-2 border-brut-black bg-brut-inverse px-2 py-1 font-mono text-[11px] leading-tight whitespace-nowrap text-brut-on-accent shadow-[4px_4px_0_var(--color-brut-blue)]"
        ></div>
        <p class="mt-2 font-mono text-[10px] text-brut-muted"><LocalizedText id={messages.coding.contributionChartHelp} /></p>
      </>
    ) : (
      <p class="mt-4 font-mono text-sm text-brut-muted">
        <LocalizedText id={messages.coding.contributionDataIsUnavailable} /> <a class="underline" href={`${GITHUB_PROFILE}?tab=overview`} target="_blank" rel="noopener noreferrer"><LocalizedText id={messages.coding.viewActivityOnGithub} /></a>
      </p>
    )}
  </div>
</section>

<script src="../../browser/coding/contribution-calendar.ts"></script>

---
import { messages } from "../../lib/i18n/catalog";
import LocalizedText from "../shared/LocalizedText.astro";
import LinkPreview from "../shared/LinkPreview.astro";
---

<section id="experience" class="border-b-2 border-brut-black bg-brut-surface">
  <div class="grid laptop:grid-cols-[minmax(15rem,0.8fr)_minmax(0,1.6fr)]">
    <div class="border-b-2 border-brut-black bg-brut-red p-6 text-brut-on-accent tablet:p-8 laptop:border-b-0 laptop:border-r-2 laptop:p-10">
      <p class="brut-label inline-block bg-brut-surface px-2 py-1"><LocalizedText id={messages.coding.experience} /></p>
      <h2 class="mt-8 max-w-lg font-display text-4xl font-black leading-[1.05] tracking-tighter tablet:text-5xl">
        <LocalizedText id={messages.coding.experienceTitle} />
      </h2>
    </div>
    <div class="p-6 tablet:p-8 laptop:p-10">
      <div class="flex flex-col gap-2 tablet:flex-row tablet:items-start tablet:justify-between">
        <div>
          <h3 class="font-display text-3xl font-black tracking-tight">
            <LocalizedText id={messages.coding.backendEngineer} /> <LinkPreview href="https://bicotexsoftware.com/" note={messages.coding.employerDescription}>Bicotex Software</LinkPreview>
          </h3>
        </div>

      </div>
      <p class="font-mono text-xs font-bold text-brut-muted"><LocalizedText id={messages.coding.february2026Present} /></p>
      <p class="mt-6 max-w-3xl text-lg leading-8"><LocalizedText id={messages.coding.experienceDescription} /></p>
      <ul class="mt-6 grid gap-4 border-t-2 border-brut-black pt-6 leading-7 tablet:grid-cols-2 tablet:gap-8">
        <li><LocalizedText id={messages.coding.apiResponsibilities} /></li>
        <li><LocalizedText id={messages.coding.securityResponsibilities} /></li>
        <li><LocalizedText id={messages.coding.workflowResponsibilities} /></li>
      </ul>
    </div>
  </div>
</section>

---
import { messages } from "../lib/i18n/catalog";
import LocalizedText from "./LocalizedText.astro";
import { musicJourneyCopy } from "../lib/i18n";
import portraitSources from "../../public/images/influences/sources.json";

const moments = [
  {
    period: messages.music.sharedBeginnings,
    shared: {
      copy: musicJourneyCopy.chapters[0],
      artists: [["skrillex", "Skrillex"], ["zomboy", "Zomboy"], ["bmth", "Bring Me the Horizon"]],
    },
  },
  {
    period: messages.music.adolescenceParallelPaths,
    shared: {
      copy: musicJourneyCopy.chapters[1],
      artists: [["linkin-park", "Linkin Park"], ["marshmello", "Marshmello"], ["post-malone", "Post Malone"], ["twenty-one-pilots", "Twenty One Pilots"]],
    },
  },
  {
    period: messages.music.overlappingDiscoveries,
    root: {
      copy: musicJourneyCopy.chapters[2],
      artists: [["mr-bill", "Mr. Bill"], ["chime", "Chime"], ["ace-aura", "Ace Aura"], ["au5", "Au5"], ["voltra", "VOLTRA"]],
    },
    discovery: {
      copy: musicJourneyCopy.chapters[3],
      artists: [["joji", "Joji"], ["fujii-kaze", "Fujii Kaze"], ["tyler-the-creator", "Tyler, the Creator"]],
    },
  },
  {
    period: messages.music.turningPoint,
    discovery: {
      copy: musicJourneyCopy.chapters[4],
      artists: [["jacob-collier", "Jacob Collier"]],
      milestone: true,
      link: "https://www.youtube.com/watch?v=VPLCk-FTVvw",
    },
  },
  {
    period: messages.music.fromListeningToPlaying,
    discovery: {
      copy: musicJourneyCopy.chapters[5],
      artists: [["keith-jarrett", "Keith Jarrett"], ["bill-evans", "Bill Evans"]],
      milestone: true,
    },
  },
  {
    period: messages.music.pathsDrawCloser,
    discovery: {
      copy: musicJourneyCopy.chapters[6],
      artists: [["opn", "Oneohtrix Point Never"], ["boards-of-canada", "Boards of Canada"], ["cubalibre-exe", "cubalibre.exe"], ["sakamoto", "Ryuichi Sakamoto"]],
    },
  },
];
const keyArtists = new Set(["skrillex", "jacob-collier", "keith-jarrett", "sakamoto"]);
const groups = new Set(["bmth", "linkin-park", "twenty-one-pilots", "boards-of-canada"]);
const portraits = new Map(portraitSources.map(source => [source.id, source.image]));
---

<section class="journey" aria-labelledby="journey-title">
  <header class="journey-intro">
    <p class="brut-label"><LocalizedText id={messages.music.influences} /></p>
    <h2 id="journey-title">{musicJourneyCopy.title[0]}</h2>
    <p class="journey-subtitle"><em>{musicJourneyCopy.subtitle[0]}</em></p>
    {musicJourneyCopy.intro.map(([en]) => <p data-i18n-text={en}>{en}</p>)}
  </header>

  <div class="route-key">
    <span><i class="root-mark" aria-hidden="true"></i><LocalizedText id={messages.music.electronicRootContinuous} /></span>
    <span><i class="discovery-mark" aria-hidden="true"></i><LocalizedText id={messages.music.musicalExpansionDiscoveries} /></span>
  </div>

  <div class="journey-paths" data-journey-paths>
    <svg class="journey-lines" aria-hidden="true" preserveAspectRatio="none"><path class="root-line" /><path class="discovery-line" /></svg>
    {moments.map((moment) => (
      <div class:list={["journey-moment", { "single-discovery": moment.discovery && !moment.root }]}>
        <p class="moment-period"><LocalizedText id={moment.period} /></p>
        {(["shared", "root", "discovery"] as const).map((lane) => {
          const chapter = moment[lane];
          return (
            <div class:list={["lane-cell", `${lane}-cell`]}>
              {chapter && <article class:list={["journey-chapter", { milestone: "milestone" in chapter && chapter.milestone, "wide-chapter": lane === "shared" || (lane === "discovery" && !moment.root) }]}>
                <span class="chapter-marker" data-journey-node={lane === "shared" ? "root" : lane} aria-hidden="true"></span>
                {lane === "shared" && <span class="chapter-marker shared-discovery-marker" data-journey-node="discovery" aria-hidden="true"></span>}
                <header class="chapter-heading">
                  {lane !== "shared" && <p class="chapter-lane"><LocalizedText id={lane === "root" ? messages.music.electronicRoot : messages.music.musicalExpansion} /></p>}
                  <h3>{chapter.copy.title[0]}</h3>
                </header>
                <div class="artist-grid">
                  {chapter.artists.map(([id, name]) => (
                    <figure class:list={["artist-portrait", { "artist-key": keyArtists.has(id), "artist-group": groups.has(id) }]} data-artist-id={id}>
                      <img src={portraits.get(id)} alt="" width="640" height="640" loading="lazy" decoding="async" />
                      <figcaption translate="no">{name}</figcaption>
                    </figure>
                  ))}
                </div>
                <div class="chapter-prose">
                  {chapter.copy.paragraphs.map(([en]) => <p data-i18n-text={en}>{en}</p>)}
                  {"link" in chapter && <a class="editorial-link" href={chapter.link} target="_blank" rel="noreferrer"><LocalizedText id={messages.music.listenMoonRiver} /></a>}
                </div>
              </article>}
            </div>
          );
        })}
      </div>
    ))}
    <div class="journey-present" id="journey-today">
      <span class="present-marker" data-journey-present aria-hidden="true"></span>
      <p class="brut-label"><LocalizedText id={messages.music.bothPathsNow} /></p>
      <h3>{musicJourneyCopy.chapters[7].title[0]}</h3>
      {musicJourneyCopy.chapters[7].paragraphs.map(([en]) => <p data-i18n-text={en}>{en}</p>)}
    </div>
  </div>
  <div class="journey-credits"><a class="editorial-link" href="/images/influences/credits.html"><LocalizedText id={messages.music.artistPhotoCredits} /></a></div>
</section>

<script>
  import { mountMusicJourney } from "../lib/music-journey";
  document.addEventListener("astro:page-load", mountMusicJourney);
  mountMusicJourney();
</script>

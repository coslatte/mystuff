---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="border-b-2 border-black bg-white">
  <div class="p-6 tablet:p-8 laptop:p-10">
    <a href="/experimentation" class="editorial-link">← all experiments</a>
    <p class="brut-label mt-8 text-brut-blue">04 / experiment</p>
    <h1 class="mt-3 font-display text-5xl font-black tracking-tighter tablet:text-7xl">{title}</h1>
    <div class="mt-5 grid max-w-3xl gap-3 leading-7 text-neutral-700"><slot /></div>
  </div>
</section>

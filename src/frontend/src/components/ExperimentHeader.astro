---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="border-b-2 border-black bg-white">
  <div class="p-4 tablet:p-6">
    <a href="/experimentation" class="editorial-link">← all experiments</a>
    <h1 class="mt-4 font-display text-4xl font-black tracking-tighter tablet:text-5xl">{title}</h1>
    <div class="mt-3 grid max-w-3xl gap-2 leading-7 text-neutral-700"><slot /></div>
  </div>
</section>

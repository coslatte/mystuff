---
import { translateText } from "../../lib/i18n/translate";
import type { LocalizedMessage } from "../../lib/i18n/types";

type Props = LocalizedMessage;

const { id, params } = Astro.props;
const text = translateText(id, "en", params);
---

<span
  data-i18n-text={id}
  data-i18n-param-names={params ? Object.keys(params).join(",") : undefined}
  data-i18n-param-values={params ? JSON.stringify(params) : undefined}
>{text}</span>

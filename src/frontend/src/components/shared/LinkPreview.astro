---
import "../../styles/shared/link-preview.css";
import LocalizedText from "./LocalizedText.astro";
import type { PlainMessageKey } from "../../lib/i18n/types";

interface Props {
  href: string;
  note: PlainMessageKey;
  target?: string;
  rel?: string;
}

const { href, note } = Astro.props;
---

<span class="channel-note" data-cursor-target data-cursor-region=".channel-note__tip">
  <a class="text-highlight" href={href} target="_blank" rel="noopener noreferrer" data-i18n-title={note}>
    <slot />
  </a>
  <span class="channel-note__tip">
    <LocalizedText id={note} />
  </span>
</span>

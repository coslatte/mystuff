---
interface Props {
  href: string;
  target?: string;
  rel?: string;
}

const { href, target, rel } = Astro.props;
---

<a
  class="inline-block border-2 border-brut-black bg-brut-surface px-2 py-0.5 transition-colors duration-200 hover:bg-brut-blue hover:text-brut-on-accent focus-visible:bg-brut-blue focus-visible:text-brut-on-accent focus-visible:outline-2 focus-visible:-outline-offset-4"
  href={href}
  target={target}
  rel={rel}
><slot /></a>
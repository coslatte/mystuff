---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/shell/Navbar.astro";
import Footer from "../components/shell/Footer.astro";
import BootScreen from "../components/loading/BootScreen.astro";
import MorphlingCursor from "../components/shell/MorphlingCursor.astro";
import RouteCurtain from "../components/loading/RouteCurtain.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** The upload console and the dev workbench should never be listed. */
  noindex?: boolean;
  /** `/loading` replays the splash itself, so the layout's copy stands down. */
  bootReplay?: boolean;
  showFooterContact?: boolean;
  immersive?: boolean;
}

const {
  title = "CosmicLatte",
  description = "Gabriel Paz, software engineer and music producer. Portfolio with code, music, and experiments.",
  noindex = false,
  bootReplay = false,
  showFooterContact = true,
  immersive = false,
} = Astro.props;

// Scrapers fetch og:image on their own, so a relative path is no image at all.
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/images/previews/og.png", Astro.site);
---

<!doctype html>
<html lang="en" data-theme="light" data-boot-replay={bootReplay ? "" : undefined} data-immersive={immersive ? "" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    {immersive && <meta name="referrer" content="no-referrer" />}
    <script is:inline>
      // Apply the saved palette before the first paint, even before the bundle loads.
      try {
        document.documentElement.dataset.theme = localStorage.getItem("clm_theme") === "dark" ? "dark" : "light";
      } catch {}
      document.documentElement.setAttribute("data-theme-ready", "");
    </script>
    <script is:inline>
      if (document.readyState === "loading" && !document.documentElement.hasAttribute("data-boot-replay") && !document.documentElement.hasAttribute("data-immersive")) {
        document.documentElement.setAttribute("data-boot-pending", "");
        document.documentElement.classList.add("boot-locked");
        // A blocked client bundle must still give the visitor access to the page.
        window.setTimeout(() => {
          if (!document.documentElement.hasAttribute("data-boot-pending")) return;
          document.querySelector("[data-boot-screen]")?.remove();
          document.documentElement.removeAttribute("data-boot-pending");
          document.documentElement.classList.remove("boot-locked");
          document.querySelectorAll("body > header, body > main, body > footer").forEach(element => {
            element.inert = document.documentElement.classList.contains("route-locked");
          });
        }, 6500);
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="cosmiclatte.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Gabriel Paz. Code, music, and browser experiments." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body id="page-top" tabindex="-1" data-immersive={immersive ? "" : undefined} class:list={["flex min-h-screen flex-col", immersive && "bg-black text-white"]}>
    {!immersive && <BootScreen />}
    {!immersive && <RouteCurtain />}
    {!immersive && <MorphlingCursor />}
    {!immersive && <Navbar />}
    <main class:list={["flex-1", !immersive && "w-full border-x-2 border-brut-black"]}>
      <slot />
    </main>
    {!immersive && <Footer showContact={showFooterContact} />}
  </body>
</html>

<script>
  import { writeText } from "../services/storage";
  import { transitionTheme } from "../browser/shell/theme-transition";
  import { initLocalization } from "../browser/shell/localization";

  initLocalization();

  if (new URLSearchParams(location.search).has("viewport-debug")) {
    const panel = document.createElement("pre");
    panel.dataset.viewportDebug = "true";
    panel.style.cssText = "position:fixed;top:0;left:0;z-index:2147483647;margin:0;padding:8px;background:#fff;color:#000;font:12px/1.4 monospace;white-space:pre-wrap;pointer-events:none";
    document.body.append(panel);

    const updateViewportReadout = () => {
      const root = document.documentElement;
      const bodyWidth = document.body.getBoundingClientRect().width;
      const body = document.body;
      const main = document.querySelector("main");
      const mainWidth = main?.getBoundingClientRect().width ?? 0;
      const visual = window.visualViewport;
      const overflow = [...document.querySelectorAll("body *")]
        .filter((element) => !element.closest("[data-viewport-debug]"))
        .map((element) => ({ element, right: element.getBoundingClientRect().right }))
        .filter(({ right }) => right > root.clientWidth + 1)
        .sort((a, b) => b.right - a.right)
        .slice(0, 3)
        .map(({ element, right }) => {
          const name = `${element.tagName.toLowerCase()}${element.id ? `#${element.id}` : ""}.${String(element.className).split(/\s+/).slice(0, 2).join(".")}`;
          return `${name} right ${Math.round(right)}`;
        });
      panel.textContent = [
        `screen: ${screen.width} × ${screen.height}`,
        `inner: ${innerWidth} × ${innerHeight}`,
        `document: ${root.clientWidth} client / ${root.scrollWidth} scroll`,
        `body/main: ${Math.round(bodyWidth)} / ${Math.round(mainWidth)} rect`,
        `body/main scroll: ${body.scrollWidth} / ${main?.scrollWidth ?? 0}`,
        `overflow: ${overflow.join("; ") || "none"}`,
        `visual: ${Math.round(visual?.width ?? 0)} @ ${visual?.scale ?? 0}`,
      ].join("\n");
    };

    updateViewportReadout();
    window.visualViewport?.addEventListener("resize", updateViewportReadout);
    window.addEventListener("resize", updateViewportReadout);
  }

  let cancelThemeTransition = () => {};

  function syncThemeToggle() {
    const button = document.querySelector("[data-theme-toggle]");
    button?.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "dark"));
    button?.setAttribute("aria-disabled", String(document.documentElement.hasAttribute("data-theme-transition")));
  }

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || !event.target.closest("[data-theme-toggle]")) return;
    if (document.documentElement.hasAttribute("data-theme-transition")) return;
    const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    cancelThemeTransition = transitionTheme({
      applyTheme: () => {
        document.documentElement.dataset.theme = theme;
        writeText("clm_theme", theme);
        syncThemeToggle();
      },
      onFinish: syncThemeToggle,
    });
    syncThemeToggle();
  });

  document.addEventListener("astro:before-swap", (event) => {
    cancelThemeTransition();
    event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
    event.newDocument.documentElement.setAttribute("data-theme-ready", "");
  });
  document.addEventListener("astro:page-load", syncThemeToggle);
</script>

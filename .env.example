# Copiar a .env (en la RAIZ del repo) y editar segun entorno.
# Este .env es leido por docker-compose.yml y por backend/run.ps1. NO existe
# backend/.env: .env va siempre en la raiz. Spring Boot no lee .env por si solo,
# solo run.ps1 lo carga; si arrancas desde IntelliJ/mvnw directo, usa las
# variables del entorno (EnvFile) o los defaults de application.yml.

# ============ 1. BASE DE DATOS (Supabase PostgreSQL) ============
# Obtener en Supabase: Project -> Connect -> Session pooler -> JDBC.
# IMPORTANTE: usa el Session pooler (puerto 5432), NO el transaction pooler
# (6543) para Hibernate. Reemplaza <REGION> y <PASSWORD> (URL-encode si el
# password trae @ # & ? o espacios). alternativamente copia la cadena entera en JDBC_URL.
# JDBC_URL=jdbc:postgresql://aws-<REGION>.pooler.supabase.com:5432/postgres?user=postgres.<PROJECT_REF>&password=<PASSWORD>&sslmode=require
DB_HOST=aws-<REGION>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.<PROJECT_REF>
DB_PASSWORD=<PASSWORD>
DB_SSLMODE=require

# --- Desarrollo local con Docker (descomenta y comenta el bloque Supabase) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cosmiclatte
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_SSLMODE=disable

# ============ 2. SUPABASE STORAGE (sube/sirve MP3 via URLs firmadas) ============
# Project URL (publica, no es secreta): https://<ref>.supabase.co
SUPABASE_URL=
# Nombre del bucket PRIVADO donde se suben los MP3 (debe existir en Supabase Storage)
SUPABASE_STORAGE_BUCKET=music
# CLAVE SECRETA del backend. NO uses la publishable/anon (sb_publishable_*): por
# defecto no puede subir/borrar en un bucket privado. Necesitas la SECRET key
# (Settings -> API Keys -> sb_secret_*). Solo backend, JAMAS al frontend.
SUPABASE_STORAGE_SERVICE_KEY=
# Segundos de validez de la URL firmada que recibe el frontend
SUPABASE_SIGNED_URL_EXPIRY=3600

# ============ 3. CORS + ADMIN ============
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000
# Clave admin (header X-Admin-Key). PRODUCCION: cambiala por un secreto real.
ADMIN_API_KEY=changeme

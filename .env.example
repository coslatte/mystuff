# Copy to .env (at the repo ROOT) and edit per environment.
# This .env is read by docker-compose.yml and src/backend/run.ps1. There is no
# src/backend/.env: .env always lives at the root. Spring Boot does not read .env on its own,
# only run.ps1 loads it; if you start from IntelliJ/mvnw directly, use
# environment variables (EnvFile) or the defaults in application.yml.

# ============ 1. DATABASE (Supabase PostgreSQL) ============
# Get it in Supabase: Project -> Connect -> Transaction pooler -> JDBC (port 6543).
# The app runtime uses the TRANSACTION pooler (6543), which
# multiplexes connections and avoids the session pooler's 15-session cap that
# caused the "EMAXCONNSESSION" deploy error. Use the raw password in DB_PASSWORD.
# The driver disables server-side prepared statements via prepareThreshold=0.
# For migrations, Supabase recommends a direct connection, or its session pooler
# when IPv4 is required. Override Spring's Flyway URL in Render to use port 5432;
# Flyway keeps DB_USERNAME and DB_PASSWORD unless those are overridden separately.
# SPRING_FLYWAY_URL=jdbc:postgresql://aws-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0
# JDBC_URL is not read by this application. Configure DB_* instead.
DB_HOST=aws-<REGION>.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=postgres.<PROJECT_REF>
DB_PASSWORD=<PASSWORD>
DB_SSLMODE=require

# --- Local development with Docker (uncomment and comment out the Supabase block) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cosmiclatte
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_SSLMODE=disable

# ============ 2. SUPABASE STORAGE (upload/serve MP3 via signed URLs) ============
# --- Local development (no cloud needed): store audio on disk ---
# With STORAGE_BACKEND=local the Supabase values below are ignored. Uploads go to
# STORAGE_LOCAL_DIR and the backend serves them from /api/local-audio/<file>, with
# Range support so the waveform/seek slider keeps working.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/audio
STORAGE_LOCAL_BASE_URL=http://localhost:8080

# --- Production: uncomment these and set STORAGE_BACKEND=supabase ---
# STORAGE_BACKEND=supabase
# Project URL (public, not secret): https://<ref>.supabase.co
SUPABASE_URL=
# Name of the PRIVATE bucket where MP3s are uploaded (must exist in Supabase Storage)
SUPABASE_STORAGE_BUCKET=music
# Backend SECRET key. Do NOT use the publishable/anon key (sb_publishable_*): by
# default it cannot upload/delete in a private bucket. You need the SECRET key
# (Settings -> API Keys -> sb_secret_*). Backend only, NEVER to the frontend.
SUPABASE_STORAGE_SERVICE_KEY=
# Seconds until the signed URL given to the frontend expires
SUPABASE_SIGNED_URL_EXPIRY=3600

# ============ 3. CORS + ADMIN ============
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4321,http://localhost:3000
# Admin key (header X-Admin-Key). Empty or changeme disables admin access.
ADMIN_API_KEY=changeme

# ============ 4. DEPLOYMENT ============
# Render: Docker service, root directory backend, Dockerfile ./Dockerfile,
# health check /health. PORT is supplied by Render and read by Spring Boot.
# Set DB_*, STORAGE_BACKEND=supabase, SUPABASE_URL,
# SUPABASE_STORAGE_BUCKET, SUPABASE_STORAGE_SERVICE_KEY and ADMIN_API_KEY.
# Set CORS_ALLOWED_ORIGINS to the exact public frontend origin, without a trailing
# slash. Do not copy STORAGE_BACKEND=local to Render's ephemeral filesystem.
# Vercel: root directory frontend; set PUBLIC_API_URL to the HTTPS Render origin
# before building. Its default is localhost and cannot reach a deployed backend.
# This root .env is not uploaded to either service; configure their dashboards.

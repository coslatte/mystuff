---
import Layout from "../layouts/Layout.astro";
import MusicSection from "../components/MusicSection";
---

<Layout title="music | cosmiclatte">
  <section class="grid grid-cols-1 border-b-2 border-black md:grid-cols-[3fr_2fr]">
    <div class="flex flex-col justify-between border-black p-8 md:border-r-2 md:p-12">
      <div>
        <h1 class="font-display text-4xl font-black tracking-tighter sm:text-6xl">music.</h1>
      </div>
      <p class="mt-10 max-w-md font-mono text-sm text-gray-700">
        play, rate and comment. data served from spring boot.
      </p>
    </div>

    <div class="flex items-end justify-between bg-black p-8 md:p-12">
      <span class="font-display text-2xl font-black text-white">↗ 01—04</span>
      <span class="bg-brut-red px-2 py-1 font-mono text-xs font-bold text-white">(2016—2026)</span>
    </div>
  </section>

  <MusicSection client:load />
</Layout>

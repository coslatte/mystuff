---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Música | CosmicLatte">
  <section>
    <h1 class="text-2xl font-semibold">Galería de música</h1>
    <p class="mt-2 text-sm text-zinc-400">Reproduce, comenta y califica. Datos servidos desde Spring Boot.</p>
    <div id="music-root" class="mt-8 grid gap-6"></div>
  </section>

  <script>
    import { api } from "../services/api";

    async function load() {
      const root = document.getElementById("music-root")!;
      try {
        const songs = await api.getSongs();
        if (!songs.length) {
          root.innerHTML = '<p class="text-zinc-500">No hay canciones aún.</p>';
          return;
        }
        root.innerHTML = songs
          .map(
            (s) => `
            <article class="rounded-xl border border-zinc-800 p-5">
              <h2 class="font-medium">${s.title} — <span class="text-zinc-400">${s.artist}</span></h2>
              ${s.audioUrl ? `<audio controls src="${s.audioUrl}" class="mt-3 w-full"></audio>` : ""}
              <p class="mt-2 text-xs text-zinc-500">Rating promedio: ${s.avgRating ?? "—"}</p>
            </article>
          `
          )
          .join("");
      } catch (e) {
        root.innerHTML = `<p class="text-red-400 text-sm">Error cargando música: ${(e as Error).message}</p>`;
      }
    }

    load();
  </script>
</Layout>

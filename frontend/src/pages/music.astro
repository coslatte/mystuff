---
import Layout from "../layouts/Layout.astro";
import MusicSection from "../components/MusicSection";
import SocialButton from "../components/SocialButton.astro";

const socials = [
  { name: "soundcloud", url: "https://soundcloud.com/cosmiclattemusic" },
  { name: "spotify", url: "https://open.spotify.com/intl-es/artist/35cspPwQYNmbLf76EbI0oP" },
  { name: "bandcamp", url: "https://cosmiclatteedm.bandcamp.com/" },
] as const;
---

<Layout title="music | cosmiclatte">
  <section class="grid grid-cols-1 border-b-2 border-black md:grid-cols-[3fr_3fr]">
    <div class="flex flex-col justify-between gap-4 p-6 md:p-8">
      <h1 class="font-display text-4xl font-black tracking-tighter sm:text-6xl">songs i've made.</h1>
      <div class="flex flex-wrap gap-2">
        {socials.map((social) => (
          <SocialButton name={social.name} url={social.url} />
        ))}
      </div>
      <p class="max-w-md font-mono text-sm text-gray-700">play, rate and comment if u like <span class="bg-yellow-100 px-1">&#58;&gt;</span></p>
    </div>
  </section>

  <MusicSection client:load />
</Layout>

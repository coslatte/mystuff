---
import Layout from "../layouts/Layout.astro";
---

<Layout title="CosmicLatte | Portfolio">
  <section class="py-12">
    <h1 class="text-4xl font-bold tracking-tight">Hola, soy CosmicLatte</h1>
    <p class="mt-4 max-w-2xl text-zinc-400">
      Portfolio personal. Descubre mi música, deja comentarios y califica las canciones.
    </p>
    <a href="/music" class="mt-6 inline-block rounded-lg bg-white px-5 py-2.5 text-sm font-medium text-zinc-900">
      Explorar música
    </a>
  </section>
</Layout>

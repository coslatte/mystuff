---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import RepoRow from "../components/RepoRow.astro";
import { fetchPinnedRepos, fetchRepoMediaImage } from "../services/github";
import type { RepoView } from "../types/github";

// The pinned repos are the single source of truth for this section. When the
// GitHub API is unavailable (no token, rate limit, outage) we show an empty
// state instead of a hardcoded list that would drift from the real profile.
const pinned = await fetchPinnedRepos("coslatte");

const repos: RepoView[] = await Promise.all(
  pinned.map(async (repo, index): Promise<RepoView> => ({
    index: String(index + 1).padStart(2, "0"),
    title: repo.name.toLowerCase(),
    category: repo.primaryLanguage?.name?.toLowerCase() || "project",
    description: repo.description?.toLowerCase() || "no description provided.",
    tags: repo.repositoryTopics.nodes.map((node) => node.topic.name),
    imageSrc: await fetchRepoMediaImage(repo.url),
    githubUrl: repo.url,
  }))
);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=3600"
);
---

<Layout title="repos | cosmiclatte">
  <Hero />

  <section id="repos" class="border-t-2 border-black">
    <div class="flex items-center justify-between border-b-2 border-black bg-black px-3 py-3 font-mono text-sm font-bold text-white">
      <a
        href="https://github.com/coslatte?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="brut-up brut-up--on-dark brut-up--seam"
      >
        <span>view repositories ↗</span>
      </a>
    </div>

    {repos.length > 0
      ? repos.map((repo) => <RepoRow {...repo} />)
      : (
        <p class="border-b-2 border-black bg-white p-8 text-center font-mono text-sm">
          could not load the repos right now.{" "}
          <a
            href="https://github.com/coslatte?tab=repositories"
            target="_blank"
            rel="noopener noreferrer"
            class="text-brut-red underline">see them on github ↗</a>
        </p>
      )}

    <div class="border-black bg-white p-8 text-center font-mono">
      want to contact me?{" "}
      <a href="mailto:hola@coslatte.dev" class="text-brut-red underline">send me an email</a>.
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import PigmentFlow from "../components/PigmentFlow";
---

<Layout title="spectral | cosmiclatte">
  <section class="border-b-2 border-black">
    <div class="flex flex-col justify-between gap-3 p-6 tablet:p-8">
      <h1 class="font-display text-4xl font-black tracking-tighter tablet:text-6xl tv:text-7xl">spectral.</h1>
      <aside class="max-w-2xl border-l-4 border-black bg-yellow-100 px-4 py-3 font-mono text-sm">
        <strong class="block">experimental page</strong>
        a space to test ideas and play with code, outside the main portfolio. things may change or break.
      </aside>
      <p class="max-w-2xl font-mono text-sm text-gray-700">
        pigment carried by a simulated fluid. where two currents cross their colours mix the way paint
        mixes, in <span class="bg-yellow-100 px-1">kubelka-munk</span> space rather than as an rgb blend.
      </p>
      <p class="brut-meta normal-case text-gray-600">
        nothing on the canvas is a stroke. emitters push a velocity field, the field transports the
        pigment, and the mixing is computed per cell by <span class="bg-yellow-100 px-1">spectral.js</span>.
      </p>
    </div>
  </section>

  <section class="border-b-2 border-black">
    <div class="p-4 tablet:p-6">
      <PigmentFlow client:load />
    </div>
  </section>
</Layout>

---
interface Props {
  title: string;
  artist: string;
  audioUrl?: string;
}

const { title, artist, audioUrl } = Astro.props;
---

<article class="rounded-xl border border-zinc-800 p-5">
  <h3 class="font-medium">{title} — <span class="text-zinc-400">{artist}</span></h3>
  {audioUrl && <audio controls src={audioUrl} class="mt-3 w-full" />}
</article>

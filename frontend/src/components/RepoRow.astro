---
interface Props {
  index: string;
  title: string;
  category: string;
  description: string;
  tags: string[];
  imageSrc?: string | null;
  demoUrl?: string;
  githubUrl?: string;
}

const { index, title, category, description, tags, imageSrc, demoUrl, githubUrl } = Astro.props;
---

<div class="grid grid-cols-1 border-b-2 border-black bg-white hover:bg-neutral-50 md:grid-cols-[15%_60%_25%]">
  <!-- index -->
  <div class="flex min-w-0 items-center justify-center overflow-hidden border-b-2 border-black bg-neutral-100 px-1 py-1.5 md:border-b-0 md:border-r-2">
    <span class="truncate font-display text-5xl font-black leading-none tracking-tighter">{index}</span>
  </div>

  <!-- metadata -->
  <div class="flex min-w-0 flex-col justify-between overflow-hidden border-b-2 border-black px-2.5 py-1.5 md:border-b-0 md:border-r-2">
    <div class="min-w-0 overflow-hidden">
      <span class="mb-1 inline-block max-w-full truncate bg-black px-1.5 py-0.5 font-mono text-xs font-bold leading-none tracking-tight text-white">
        {category}
      </span>
      <h3 class="mb-1 truncate font-display text-2xl font-black leading-none tracking-tighter">{title}</h3>
      <p class="mb-1 line-clamp-2 font-mono text-sm leading-tight tracking-tight text-gray-700">{description}</p>
    </div>

    <div class="flex flex-wrap gap-1 overflow-hidden">
      {tags.map((tag) => (
        <span class="max-w-full truncate border border-black bg-neutral-100 px-1.5 py-0.5 font-mono text-xs leading-none tracking-tight">#{tag}</span>
      ))}
    </div>
  </div>

  <!-- preview -->
  <div class="flex min-w-0 flex-col justify-between overflow-hidden bg-neutral-200 p-1.5">
    <div class="relative mb-1 aspect-[2/1] overflow-hidden border-2 border-black bg-black">
      {imageSrc ? (
        <>
          <img src={imageSrc} alt={title} class="h-full w-full object-cover contrast-90" />
          <span class="absolute right-2 top-2 border border-white bg-black px-1.5 py-0.5 font-mono text-[10px] text-white">
            preview
          </span>
        </>
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-neutral-200">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="absolute inset-0 h-full w-full">
            <line x1="0" y1="0" x2="100" y2="100" stroke="black" stroke-width="2" vector-effect="non-scaling-stroke" opacity="0.3" />
          </svg>
          <span class="relative flex items-center gap-1.5 font-mono text-sm font-bold">
            no media
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
              <circle cx="12" cy="13" r="4" />
            </svg>
          </span>
        </div>
      )}
    </div>

    <div class="grid grid-cols-1 gap-1">
      {demoUrl && (
        <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="brut-btn !py-1 text-center text-xs leading-none">
          demo ↗
        </a>
      )}
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-black bg-black py-1 text-center text-xs font-bold leading-none text-white transition-none hover:bg-brut-red"
        >
          code
        </a>
      )}
    </div>
  </div>
</div>

---
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const links = [
  { href: "/", label: "coding", active: pathname === "/" },
  { href: "/music", label: "music", active: pathname === "/music" },
  { href: "/spectral", label: "spectral", active: pathname === "/spectral" },
  { href: "/subdivision", label: "subdivision", active: pathname === "/subdivision" },
];
---

<header class="border-b-2 border-black bg-white">
  <div class="mx-auto flex w-full max-w-7xl items-stretch justify-between">
    <a href="/" class="flex items-center border-r-2 border-black bg-black px-6 py-4 font-display text-2xl font-black tracking-tighter text-white">
      cosmiclatte
    </a>

    <nav class="flex items-stretch font-mono text-xs tablet:text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={link.active ? "page" : undefined}
          class:list={[
            "flex items-center border-r-2 border-black px-3 font-bold hover:bg-brut-black hover:text-white tablet:px-6",
            { "border-l-2": link.href === "/" },
            { "bg-brut-black text-white": link.active },
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

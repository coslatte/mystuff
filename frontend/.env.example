# URL publica del backend Spring Boot (prefijo PUBLIC_ = visible en el navegador).
# Local: http://localhost:8080 | Produccin (Vercel): la URL de tu backend deployado.
PUBLIC_API_URL=http://localhost:8080

# Token de acceso de GitHub para consultar pinned repos vía GraphQL.
# Importante: NO usar prefijo PUBLIC_ (si no, el token queda expuesto en el cliente).
# Crear en: GitHub > Settings > Developer settings > Personal access tokens (classic)
# Permisos de lectura pública: public_repo (o read:user).
GITHUB_TOKEN=
